# ────────────────────────────────────────────────────────────────────────────
# Brizo Lead Finder — пример переменных окружения
# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в git!
# ────────────────────────────────────────────────────────────────────────────

# Пароль для входа в сам веб-интерфейс Lead Finder
# (защита от посторонних; любое слово на ваш выбор)
APP_PASSWORD=your_secret_password_here

# Адрес Brizo CRM (обычно не меняется)
BRIZO_URL=https://sad1.brizo.ru

# Порт, на котором запустится сервер (Railway/Render подставят сами)
# PORT=8082
